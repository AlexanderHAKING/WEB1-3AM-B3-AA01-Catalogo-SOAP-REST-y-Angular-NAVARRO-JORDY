      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IProductoService/ObtenerProducto\"" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:temp=\"http://tempuri.org/\">\n  <soapenv:Header/>\n  <soapenv:Body>\n    <temp:ObtenerProducto>\n      <temp:id>1</temp:id>\n    </temp:ObtenerProducto>\n  </soapenv:Body>\n</soapenv:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": { "raw": "http://localhost:5232/ProductoService.svc" }
      }
    },
    {
      "name": "4. Agregar producto",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IProductoService/AgregarProducto\"" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:temp=\"http://tempuri.org/\">\n  <soapenv:Header/>\n  <soapenv:Body>\n    <temp:AgregarProducto>\n      <temp:producto>\n        <temp:Descripcion>Botella termica de acero 750ml</temp:Descripcion>\n        <temp:Estado>true</temp:Estado>\n        <temp:IdCategoria>3</temp:IdCategoria>\n        <temp:Nombre>Termo Andes</temp:Nombre>\n        <temp:Precio>18.75</temp:Precio>\n        <temp:Stock>22</temp:Stock>\n      </temp:producto>\n    </temp:AgregarProducto>\n  </soapenv:Body>\n</soapenv:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": { "raw": "http://localhost:5232/ProductoService.svc" }
      }
    },
    {
      "name": "5. Actualizar producto",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IProductoService/ActualizarProducto\"" }
