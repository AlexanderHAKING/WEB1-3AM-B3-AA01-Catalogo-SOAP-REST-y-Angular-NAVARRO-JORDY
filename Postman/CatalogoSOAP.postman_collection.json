T{
  "info": {
    "name": "Catalogo SOAP - Productos y Categorias",
    "description": "Coleccion para probar el servicio SOAP de productos y categorias.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Obtener categorias",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IProductoService/ObtenerCategorias\"" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:temp=\"http://tempuri.org/\">\n  <soapenv:Header/>\n  <soapenv:Body>\n    <temp:ObtenerCategorias/>\n  </soapenv:Body>\n</soapenv:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": { "raw": "http://localhost:5232/ProductoService.svc" }
      }
    },
    {
      "name": "2. Obtener productos",
