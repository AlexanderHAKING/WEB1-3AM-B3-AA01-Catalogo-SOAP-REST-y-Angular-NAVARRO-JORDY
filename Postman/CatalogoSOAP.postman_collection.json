          "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:temp=\"http://tempuri.org/\">\n  <soapenv:Header/>\n  <soapenv:Body>\n    <temp:ObtenerProductosPorCategoria>\n      <temp:idCategoria>1</temp:idCategoria>\n    </temp:ObtenerProductosPorCategoria>\n  </soapenv:Body>\n</soapenv:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": { "raw": "http://localhost:5232/ProductoService.svc" }
